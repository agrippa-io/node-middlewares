    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.12.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.17.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.19.19",
